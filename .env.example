# Deployment template. Copy to .env on the server and replace example values.
# Requires PHP 8.2+ and the PDO extension for your chosen database.
# Serve backend/public; storage and bootstrap/cache must be writable by PHP.
APP_NAME="SK Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Backend origin, without /api or a trailing slash.
APP_URL=https://api.example.com
# Frontend origin used to generate /invite/{token} links; no trailing slash.
FRONTEND_URL=https://portal.example.com
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Create the database and its user before running migrations.
# Use the actual database/user names supplied by your hosting provider.
# For MariaDB, change DB_CONNECTION to mariadb.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sk_portal
DB_USERNAME=sk_portal
DB_PASSWORD="replace-with-database-password"
DB_CHARSET=utf8mb4
# Compatible with MySQL and MariaDB; avoids MySQL-8-only collation defaults.
DB_COLLATION=utf8mb4_unicode_ci
# Optional: absolute path to the CA certificate required by your database host.
# MYSQL_ATTR_SSL_CA=/absolute/path/to/ca.pem

# These tables are created by the included migrations. Redis is not required.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database

# Execute jobs immediately; no queue worker is needed with this setting.
# If changed to database, run a supervised php artisan queue:work process.
QUEUE_CONNECTION=sync

# Avatar uploads explicitly use the public disk, independently of this default.
# Run php artisan storage:link to expose them at APP_URL/storage.
FILESYSTEM_DISK=local

# Log mail until a real mail provider is configured; this does not send email.
# For SMTP, set MAIL_MAILER=smtp and fill in your provider's settings.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional for future Sanctum cookie authentication: hostnames with ports,
# comma-separated, without https://. Current API login uses bearer tokens.
# SANCTUM_STATEFUL_DOMAINS=portal.example.com

# First deployment, from backend/ after filling in the server's .env:
# composer install --no-dev --optimize-autoloader
# php artisan config:clear
# php artisan key:generate --force
# php artisan migrate --force
# php artisan db:seed --class=RolePermissionSeeder --force
# php artisan storage:link
# The default DatabaseSeeder also creates sample officials and governance data;
# use only RolePermissionSeeder above for production roles and permissions.
# Generate APP_KEY only for a new installation; retain it on later deploys.
# Do not run config:cache or optimize yet: InvitationController currently reads
# FRONTEND_URL via env() outside config/, which breaks with cached config unless
# FRONTEND_URL is also set in the server process environment.
# Health endpoint: GET /up (does not verify database connectivity).
# Local HTTP use: change URLs to localhost origins, APP_ENV=local,
# APP_DEBUG=true and SESSION_SECURE_COOKIE=false.
